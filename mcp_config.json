{
  "mcpServers": {
    "notion": {
      "command": "npx",
      "args": ["-y", "@ramidecodes/mcp-server-notion"],
      "env": {"NOTION_KEY": "<YOUR_NOTION_KEY>"},
      "transport": "stdio"
    },
    "canva": {
      "command": "npx",
      "args": ["-y", "mcp-remote@latest", "https://mcp.canva.com/mcp"],
      "transport": "stdio"
    }
  }
}
